# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail OAuth2
# Create at: https://console.cloud.google.com
# Enable Gmail API → Credentials → OAuth 2.0 Client ID → Web application
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Production: GMAIL_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback

# Session encryption (iron-session)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate_a_32_byte_random_hex_string_here

# Cron job secret — must match the value set in Vercel environment variables
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=25af9d0c17f755bca78045442b726418e8ae68aea7b14d6815f8f044f6769aef
# Exposed to the browser so the Extract bookings button can call the cron endpoint directly
NEXT_PUBLIC_CRON_SECRET=25af9d0c17f755bca78045442b726418e8ae68aea7b14d6815f8f044f6769aef

# Supabase — find these at: https://supabase.com/dashboard/project/_/settings/api
# Run supabase/schema.sql in the SQL editor before first use
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key